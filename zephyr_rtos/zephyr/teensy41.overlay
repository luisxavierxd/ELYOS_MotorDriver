/*
 * Device Tree Overlay para Teensy 4.1
 */

/ {
    aliases {
        // PWM aliases para FOC
        pwm-phase-a = &flexpwm2_pwm0;
        pwm-phase-b = &flexpwm2_pwm2;
        pwm-phase-c = &flexpwm2_pwm3;
        
        // Dispositivos FOC
        adc-motor = &adc1;
        uart-telem = &lpuart6;
        spi-mag = &lpspi3;
    };
};

&lpspi3 {
    status = "okay";
    
    // Sensor magnético SPI
    mag_sensor: as5048a@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <10000000>;
        label = "MAG_SENSOR";
    };
};

&lpuart6 {
    status = "okay";
    current-speed = <115200>;
};

&flexpwm2_pwm0 {
    status = "okay";
};

&flexpwm2_pwm2 {
    status = "okay";
};

&flexpwm2_pwm3 {
    status = "okay";
};

&adc1 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
};

/ { chosen { zephyr,console = &cdc_acm_uart0; }; };

&zephyr_udc0 { cdc_acm_uart0: cdc_acm_uart0 { compatible = "zephyr,cdc-acm-uart"; label = "CDC_ACM_0"; }; };
