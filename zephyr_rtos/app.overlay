/*
 * Device Tree Overlay para Teensy 4.1 - Proyecto ELYOS Motor Driver
 */

/ {
    aliases {
        led0 = &led0;
        
        // PWM aliases para FOC
        pwm-phase-a = &flexpwm2_pwm0;
        pwm-phase-b = &flexpwm2_pwm2;
        pwm-phase-c = &flexpwm2_pwm3;
        
        // ADC
        adc-current = &adc1;
        adc-throttle = &adc1;
        
        // UART Telemetria
        uart-telem = &lpuart2;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio9 3 GPIO_ACTIVE_HIGH>;
            label = "User LED";
        };
    };
};

&lpspi1 {
    status = "okay";
    
    // Configuración del sensor magnético SPI
    mag_sensor: as5048a@0 {
        compatible = "vnd,spi-device";
        reg = <0>;
        spi-max-frequency = <10000000>;
        label = "MAG_SENSOR";
    };
};

&lpuart2 {
    status = "okay";
    current-speed = <115200>;
};

&flexpwm2_pwm0 {
    status = "okay";
};

&flexpwm2_pwm2 {
    status = "okay";
};

&flexpwm2_pwm3 {
    status = "okay";
};

&adc1 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
};
